" Other filetypes
filetype * xdg-open

" FZF
command! FZFlocate : set noquickview
        \| let $FZF_PICK = term('locate $HOME | fzf --border 2>/dev/tty')
        \| if $FZF_PICK != ''
        \|     execute 'goto' fnameescape($FZF_PICK)
        \| endif
command! FZFfind : set noquickview
        \| let $FZF_PICK = term('fd -HI . | fzf --border 2>/dev/tty')
        \| if $FZF_PICK != ''
        \|     execute 'goto' fnameescape($FZF_PICK)
        \| endif
command! FZFcd : set noquickview
        \| let $FZF_PICK = term('fd -H -t d . | fzf --border 2>/dev/tty')
        \| if $FZF_PICK != ''
        \|     execute 'cd' fnameescape($FZF_PICK)
        \| endif
command! FZFgcd : set noquickview
        \| let $FZF_PICK = term('fd -H -t d . / | fzf --border 2>/dev/tty')
        \| if $FZF_PICK != ''
        \|     execute 'cd' fnameescape($FZF_PICK)
        \| endif

nnoremap ,l :FZFlocate<cr>
nnoremap ,f :FZFfind<cr>
nnoremap gd :FZFcd<cr>
nnoremap gD :FZFgcd<cr>

" Mappings
nnoremap s :shell<cr>
nnoremap S :sort<cr>
nnoremap w :view<cr>
vnoremap w :view<cr>gv
nnoremap gf :file<cr>
nnoremap gb :file &<cr>l
nnoremap yd :!echo -n %d | xsel --input --primary %i &&
        \ echo -n %d | xsel --clipboard --input %i<cr>
nnoremap yf :!echo -n %c:p | xsel --input --primary %i &&
        \ echo -n %c:p | xsel --clipboard --input %i<cr>
nnoremap I cw<c-a>
nnoremap cc cw<c-u>
nnoremap A cw
nnoremap ,t :!konsole &<cr>
nnoremap ,c :write | edit $MYVIFMRC | restart full<cr>
nnoremap ,w :set wrap!<cr>
nnoremap <f3> :!vim -R %f<cr>
nnoremap <f4> :edit<cr>
nnoremap <f5> :copy<cr>
nnoremap <f6> :move<cr>
nnoremap <f7> :mkdir<space>
nnoremap <f8> :delete<cr>
nnoremap <a-i> :sync<cr>
nnoremap <a-o> :sync %c<cr>
nnoremap <c-u> <c-w>x
map <space> tj
map <c-\> :bmarks<cr>
map * ggVG<cr>

source $HOME/.config/vifm/vifm_devicons/favicons.vifm
